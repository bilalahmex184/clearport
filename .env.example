# ClearPort Environment Variables
# Copy this file to .env and fill in your values

# Supabase (public anon key — safe to expose, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1

# Supabase Management API token (for test cleanup only — NOT for production)
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_MANAGEMENT_TOKEN=your-management-token

# Gemini AI (for OCR extraction — get from https://aistudio.google.com/apikey)
# Set as Supabase secret: npx supabase secrets set GEMINI_API_KEY=your-key
GEMINI_API_KEY=your-gemini-key

# CORS origin for edge functions (set as Supabase secret)
# npx supabase secrets set ALLOWED_ORIGIN=https://your-domain.com
ALLOWED_ORIGIN=http://localhost:3000

# Sentry (optional — for error + performance monitoring)
# App works fine without these in local dev: Sentry.init() no-ops when no DSN is set.
# Get your DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser (used by sentry.client.config.ts)
# SENTRY_DSN is server-only (used by sentry.server.config.ts + sentry.edge.config.ts).
# Either one alone is enough; setting both lets browser + server events flow into the same project.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional: Sentry org/project slugs (only used by `withSentryConfig` for source map uploads,
# which we don't enable — no SENTRY_AUTH_TOKEN is set in this env).
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# OCR service (self-hosted tesseract.js — called by extract-document edge function)
# Generate with: openssl rand -hex 32
INTERNAL_OCR_SECRET=your-ocr-secret
# Set OCR_SERVICE_URL as a Supabase secret pointing to your app's /api/internal/ocr endpoint
# OCR_SERVICE_URL=https://your-domain.com/api/internal/ocr

# Google Cloud Vision OCR (optional — Tier 3 extraction fallback for images)
# Independent hosted OCR vendor, free monthly quota (1,000 requests/month).
# Handles IMAGE mime types only (PNG/JPEG/TIFF); PDFs fall through to Tesseract
# (Tier 4) which calls the Node route with pdftoppm. Set as a Supabase secret:
#   npx supabase secrets set GOOGLE_CLOUD_VISION_API_KEY=your-key
# Get from: https://console.cloud.google.com/iam-admin/credentials
# If unset, this tier is skipped silently and the cascade falls through to Tesseract.
GOOGLE_CLOUD_VISION_API_KEY=your-cloud-vision-key
