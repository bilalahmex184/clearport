# ClearPort Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# PHASE 2 KEY SCHEME — Fresh Supabase project account
# ============================================================================
# As of Phase 2, ClearPort runs on a FRESH Supabase project under a NEW
# account/organization (separate from the legacy project). The old project
# stays live and untouched until Phase 6 verifies the data migration.
#
# Why a fresh project: the legacy project's migration history includes four
# RLS-recursion fix migrations (002-006) and a Storage RLS policy that
# disagreed with the upload code on user_id-vs-org_id (Issue #39). The fresh
# project starts from supabase/migrations-new/001_baseline_schema.sql, which
# writes the correct org_id-scoped policy from the start. See:
#   docs/phase2-migration-guide.md
#
# Provisioning: https://supabase.com/dashboard → new org → new project.
# Apply: 001_baseline_schema.sql → 002_async_jobs.sql → 026_usage_limit_atomic.sql
# ============================================================================

# Supabase (public anon key — safe to expose, protected by RLS)
# Point this at the NEW project, not the legacy one.
NEXT_PUBLIC_SUPABASE_URL=https://your-new-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-new-anon-key
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://your-new-project.supabase.co/functions/v1

# Supabase service role key (SERVER-SIDE ONLY — NEVER expose to browser)
# ----------------------------------------------------------------------------
# HARD KEY SECURITY RULE:
#   - NEVER commit this key to git.
#   - NEVER reference it in client-side code, shared packages, or browser logs.
#   - ONLY load it in secure server runtimes: Next.js API routes (server),
#     Cloudflare Workers (Phase 3), or the queue worker mini-service.
#   - The legacy project's service_role key is treated as POTENTIALLY EXPOSED
#     (it lived in a codebase with a documented security-patch history). The
#     fresh project generates a NEW key; the old one is rotated in Phase 6.
#
# Required by: API routes that bypass RLS (job claims, usage-limit enforcement),
# the queue worker, and the Phase 3 ingress Worker.
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-new-service-role-key

# Supabase Management API token (for test cleanup only — NOT for production)
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_MANAGEMENT_TOKEN=your-management-token

# AI Extraction Provider — OpenRouter (the ONLY key the live extraction path uses)
# Without this, AI extraction is disabled and the pipeline silently falls back
# to regex/keyword extraction (degraded mode, not a crash).
# This is NOT Google Gemini. The extraction engine calls OpenRouter's
# OpenAI-compatible API, which routes to Qwen VL models.
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Demo mode — enables anonymous sign-in + auto-provisioning of a personal
# demo org so the app works without a real login. Set to false in production.
NEXT_PUBLIC_DEMO_MODE=true

# CORS origin for edge functions — MUST be set before going live.
# Set as a Supabase secret on EVERY edge function:
#   npx supabase secrets set ALLOWED_ORIGIN=https://your-production-domain.com
#
# IMPORTANT: the edge functions default to "*" when ALLOWED_ORIGIN is unset
# (intentional — it makes local dev work with zero config). That "*" fallback
# is INSECURE for any deployment reachable on the public internet: it lets any
# website make authenticated cross-origin requests against your edge functions.
# Before exposing the app to real users, set ALLOWED_ORIGIN to the EXACT origin
# of your deployed frontend, e.g.:
#   ALLOWED_ORIGIN=https://app.clearport.com
# (No trailing slash, no wildcards, no scheme mismatch — must match the
# browser's Origin header verbatim.)
ALLOWED_ORIGIN=http://localhost:3000

# Sentry (optional — for error + performance monitoring)
# App works fine without these in local dev: Sentry.init() no-ops when no DSN is set.
# Get your DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser (used by sentry.client.config.ts)
# SENTRY_DSN is server-only (used by sentry.server.config.ts + sentry.edge.config.ts).
# Either one alone is enough; setting both lets browser + server events flow into the same project.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional: Sentry org/project slugs (only used by `withSentryConfig` for source map uploads,
# which we don't enable — no SENTRY_AUTH_TOKEN is set in this env).
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# OCR service (self-hosted tesseract.js — called by extract-document edge function)
# Generate with: openssl rand -hex 32
INTERNAL_OCR_SECRET=your-ocr-secret
# Set OCR_SERVICE_URL as a Supabase secret pointing to your app's /api/internal/ocr endpoint
# OCR_SERVICE_URL=https://your-domain.com/api/internal/ocr

# Google Cloud Vision OCR (optional — Tier 3 extraction fallback for images)
# Independent hosted OCR vendor, free monthly quota (1,000 requests/month).
# Handles IMAGE mime types only (PNG/JPEG/TIFF); PDFs fall through to Tesseract
# (Tier 4) which calls the Node route with pdftoppm. Set as a Supabase secret:
#   npx supabase secrets set GOOGLE_CLOUD_VISION_API_KEY=your-key
# Get from: https://console.cloud.google.com/iam-admin/credentials
# If unset, this tier is skipped silently and the cascade falls through to Tesseract.
GOOGLE_CLOUD_VISION_API_KEY=your-cloud-vision-key

# ============================================================================
# Stripe billing (OPTIONAL — currently a stub)
# ============================================================================
# ClearPort's billing service (src/lib/services/billing.service.ts) is a
# stub on a $0 budget. The read paths (getOrgPlan, checkUsageLimit) work
# against the org_subscriptions + usage_limits tables (migration 025). The
# write path (upgradePlan) throws a 503 STRIPE_NOT_CONFIGURED error until
# this key is set.
#
# To wire up real billing:
#   1. Create a Stripe account + product + price for each plan tier.
#   2. Uncomment STRIPE_SECRET_KEY below and paste your secret key.
#      Get from: https://dashboard.stripe.com/apikeys
#      (Use the test key `sk_test_...` for dev, live key `sk_live_...` for prod.)
#   3. Set the webhook signing secret as STRIPE_WEBHOOK_SECRET (also below) and
#      register the /api/billing/webhook route with Stripe.
#   4. Implement the Checkout Session creation in upgradePlan() + the webhook
#      handler that upserts org_subscriptions on customer.subscription.* events.
#
# NEVER commit a real key to git. .env is gitignored; double-check before pushing.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# STRIPE_ENTERPRISE_PRICE_ID=

# ============================================================================
# Phase 6: Ingress Worker URL (cutover)
# ============================================================================
# When set, uploads route through the Cloudflare ingress Worker (new pipeline)
# instead of the old direct-Supabase + /api/internal/extract-and-validate path.
# The Worker URL is https://clearport-ingress.clearport.workers.dev
# Leave unset to use the old pipeline (feature flag controls per-org routing).
NEXT_PUBLIC_INGRESS_URL=https://clearport-ingress.clearport.workers.dev
