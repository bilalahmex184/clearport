9:["$","section",null,{"className":"bg-[#0c0d12] border border-gray-900 rounded-xl p-6","children":[["$","h2",null,{"className":"text-lg font-semibold text-gray-100 mb-2","children":"2. How Documents Are Stored"}],["$","p",null,{"className":"text-sm text-gray-400 leading-relaxed","children":["Uploaded files are stored in ",["$","span",null,{"className":"font-mono text-amber-400","children":"Supabase Storage"}],", which is encrypted at rest (AES-256) and in transit (TLS 1.2+). Storage objects are namespaced under a per-user path prefix (",["$","span",null,{"className":"font-mono text-amber-400","children":"{user_id}/..."}],") so that Row-Level Security policies can enforce isolation: every read of a storage object is checked against the caller's",["$","span",null,{"className":"font-mono","children":" auth.uid()"}],"."]}]]}]
a:["$","section",null,{"className":"bg-[#0c0d12] border border-gray-900 rounded-xl p-6","children":[["$","h2",null,{"className":"text-lg font-semibold text-gray-100 mb-2","children":"3. Per-User Data Isolation (Row-Level Security)"}],["$","p",null,{"className":"text-sm text-gray-400 leading-relaxed","children":["Every database table (",["$","span",null,{"className":"font-mono","children":"shipments"}],",",["$","span",null,{"className":"font-mono","children":" documents"}],",",["$","span",null,{"className":"font-mono","children":" document_fields"}],",",["$","span",null,{"className":"font-mono","children":" exceptions"}],",",["$","span",null,{"className":"font-mono","children":" operational_rules"}],",",["$","span",null,{"className":"font-mono","children":" audit_logs"}],") has a",["$","span",null,{"className":"font-mono text-amber-400","children":" user_id"}]," column referencing ",["$","span",null,{"className":"font-mono","children":"auth.users(id)"}],", and a Row-Level Security policy that restricts every query to rows where ",["$","span",null,{"className":"font-mono","children":"user_id = auth.uid()"}],". This means your shipment data is never visible to any other ClearPort user — even an administrator of the Supabase project cannot read your rows through the user-scoped API client."]}]]}]
b:["$","section",null,{"className":"bg-[#0c0d12] border border-gray-900 rounded-xl p-6","children":[["$","h2",null,{"className":"text-lg font-semibold text-gray-100 mb-2","children":"4. Data Sent to Google Gemini"}],["$","p",null,{"className":"text-sm text-gray-400 leading-relaxed","children":["When you upload a document, the file's contents are sent to the ",["$","span",null,{"className":"font-mono text-amber-400","children":"Google Gemini API"}]," for OCR and structured field extraction. The Gemini API receives the raw document content (PDF / image / text), processes it transiently to produce the extracted JSON, and returns the result. Gemini's processing is governed by"," ",["$","a",null,{"href":"https://ai.google.dev/terms","target":"_blank","rel":"noopener noreferrer","className":"text-amber-500 hover:text-amber-400 underline","children":"Google's AI Terms of Service"}],". ClearPort does not cache document content on Google's infrastructure beyond what Gemini's own policies permit."]}]]}]
c:["$","section",null,{"className":"bg-[#0c0d12] border border-gray-900 rounded-xl p-6","children":[["$","h2",null,{"className":"text-lg font-semibold text-gray-100 mb-2","children":"5. We Do Not Sell Your Data"}],["$","p",null,{"className":"text-sm text-gray-400 leading-relaxed","children":"ClearPort does not sell, rent, or license your uploaded documents, extracted field data, or audit logs to any third party. Data is shared only with our infrastructure providers (Supabase for storage + database, Google Gemini for extraction) strictly as needed to operate the Service, and only as permitted by their respective data processing agreements."}]]}]
d:["$","section",null,{"className":"bg-[#0c0d12] border border-gray-900 rounded-xl p-6","children":[["$","h2",null,{"className":"text-lg font-semibold text-gray-100 mb-2","children":"6. Anonymous Authentication"}],["$","p",null,{"className":"text-sm text-gray-400 leading-relaxed","children":"When you first open ClearPort, the app creates an anonymous Supabase session — no email, password, or other personal information is collected. This anonymous session is what enables the no-login UX while still enforcing Row-Level Security. The session is tied to a stable, random UUID; if you clear your browser storage you will receive a new anonymous identity and will not be able to access shipments created under the previous identity unless you later link an email/password to that session."}]]}]
e:["$","section",null,{"className":"bg-[#0c0d12] border border-gray-900 rounded-xl p-6","children":[["$","h2",null,{"className":"text-lg font-semibold text-gray-100 mb-2","children":"7. Data Retention & Deletion"}],["$","p",null,{"className":"text-sm text-gray-400 leading-relaxed mb-3","children":"Your data is retained for as long as your account is active. You may request deletion of all your data at any time by:"}],["$","ul",null,{"className":"text-sm text-gray-400 leading-relaxed list-disc pl-5 space-y-1.5","children":[["$","li",null,{"children":"Deleting individual shipments via the ClearPort UI (admin role required) — this cascades to the shipment's documents, fields, exceptions, and audit logs."}],["$","li",null,{"children":["Emailing"," ",["$","a",null,{"href":"mailto:compliance@clearport.corp","className":"text-amber-500 hover:text-amber-400 underline","children":"compliance@clearport.corp"}]," ","with a deletion request referencing your user ID (visible in the Supabase Sync panel). We will purge your records from the database, storage, and backups within 30 days."]}]]}]]}]
f:["$","section",null,{"className":"bg-[#0c0d12] border border-gray-900 rounded-xl p-6","children":[["$","h2",null,{"className":"text-lg font-semibold text-gray-100 mb-2","children":"8. Security"}],["$","p",null,{"className":"text-sm text-gray-400 leading-relaxed","children":["All API routes require a valid JWT and enforce RLS. Edge functions are JWT-verified (",["$","span",null,{"className":"font-mono","children":"verify_jwt = true"}],"). The Gemini API key is stored as a Supabase secret and never exposed to the browser. Audit logs record every reviewer action, upload, export, and rule change for traceability."]}]]}]
